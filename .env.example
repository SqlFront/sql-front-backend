POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RUNNER_PASSWORD=secret
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/users_db
GAME_DATABASE_URL=postgresql+asyncpg://sql_runner:${RUNNER_PASSWORD}@postgres:5432/game_db
QUEST_DATABASE_URL=postgresql+asyncpg://sql_runner:${RUNNER_PASSWORD}@postgres:5432/quest_db
SECRET_KEY=change_me_in_production_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Локальная разработка:
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost,http://localhost:9000,http://sqlfront.ru,https://sql-front.mirea.ru

# Пример для продакшн-сервера (при работе через подпуть /sqlfront):
# FRONTEND_URL=https://your-domain-or-ip/sqlfront
# BACKEND_URL=https://your-domain-or-ip/sqlfront
# CORS_ORIGINS=https://your-domain-or-ip

PORT=80
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
